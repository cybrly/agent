---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../lib/categories';
import { getCollection } from 'astro:content';

const sheets = await getCollection('cheatsheets');
const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c.slug, sheets.filter((s) => s.data.category === c.slug).length])
);
const totalSheets = sheets.length;
const allTags = [...new Set(sheets.flatMap((s) => s.data.tags))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold mb-3">A pentest cheatsheet that keeps up with you</h1>
    <p class="text-[var(--color-muted)] max-w-2xl mx-auto">
      Set your target once. Every payload rewrites itself. Search across {totalSheets} cheatsheets fuzzy-style. Works offline.
    </p>
    <div class="mt-6 flex flex-wrap gap-2 justify-center text-xs">
      <span class="px-2 py-1 rounded border" style="border-color: var(--color-border);">Press <kbd>/</kbd> to search</span>
      <span class="px-2 py-1 rounded border" style="border-color: var(--color-border);">Set <span class="mono">RHOST</span> above ↑</span>
      <span class="px-2 py-1 rounded border" style="border-color: var(--color-border);">Hover code to copy</span>
    </div>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-4">
    {CATEGORIES.map((c) => (
      <a
        href={`${base}/c/${c.slug}`}
        class="block p-4 rounded-lg border transition hover:border-[var(--color-accent)]"
        style="background: var(--color-card); border-color: var(--color-border);"
      >
        <div class="flex items-center gap-2 mb-1">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent)">
            <path d={c.icon}/>
          </svg>
          <h3 class="font-semibold">{c.name}</h3>
          <span class="ml-auto text-xs text-[var(--color-muted)]">{counts[c.slug]}</span>
        </div>
        <p class="text-xs text-[var(--color-muted)]">{c.blurb}</p>
      </a>
    ))}
  </section>

  {allTags.length > 0 && (
    <section class="mt-10">
      <h2 class="text-sm font-semibold text-[var(--color-muted)] uppercase tracking-wide mb-2">Browse by tag</h2>
      <div class="flex flex-wrap gap-1.5">
        {allTags.map((t) => (
          <a href={`${base}/tag/${t}`} class="px-2 py-0.5 text-xs rounded border hover:border-[var(--color-accent)]" style="border-color: var(--color-border);">#{t}</a>
        ))}
      </div>
    </section>
  )}
</Base>
