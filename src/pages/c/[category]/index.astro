---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, categoryBySlug } from '../../../lib/categories';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}
const { category } = Astro.params;
const cat = categoryBySlug(category);
if (!cat) return Astro.redirect('/');
const sheets = (await getCollection('cheatsheets', (s) => s.data.category === category))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${cat.name} — PentestCheat`} description={cat.blurb}>
  <nav class="text-xs text-[var(--color-muted)] mb-3"><a href={`${base}/`} class="hover:underline">Home</a> / {cat.name}</nav>
  <header class="mb-4">
    <h1 class="text-3xl font-bold">{cat.name}</h1>
    <p class="text-[var(--color-muted)] mt-1">{cat.blurb}</p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {sheets.map((s) => (
      <a href={`${base}/c/${cat.slug}/${s.id.split('/').pop()}`} class="block p-4 rounded-lg border hover:border-[var(--color-accent)]" style="background: var(--color-card); border-color: var(--color-border);">
        <h3 class="font-semibold">{s.data.title}</h3>
        {s.data.description && <p class="text-sm text-[var(--color-muted)] mt-1">{s.data.description}</p>}
        <div class="mt-2 flex flex-wrap gap-1">
          {s.data.tags.map((t) => (
            <span class="px-1.5 py-0.5 text-[10px] rounded bg-[var(--color-bg)] border" style="border-color: var(--color-border);">#{t}</span>
          ))}
          {s.data.ports.map((p) => (
            <span class="px-1.5 py-0.5 text-[10px] rounded bg-[var(--color-bg)] border mono" style="border-color: var(--color-border);">:{p}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Base>
