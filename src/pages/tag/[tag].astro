---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categoryBySlug } from '../../lib/categories';

export async function getStaticPaths() {
  const sheets = await getCollection('cheatsheets');
  const tags = [...new Set(sheets.flatMap((s) => s.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { sheets: sheets.filter((s) => s.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { sheets } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`#${tag} — PentestCheat`}>
  <nav class="text-xs text-[var(--color-muted)] mb-3"><a href={`${base}/`} class="hover:underline">Home</a> / #{tag}</nav>
  <h1 class="text-2xl font-bold mb-4">#{tag}</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {sheets.map((s) => {
      const cat = categoryBySlug(s.data.category)!;
      return (
        <a href={`${base}/c/${cat.slug}/${s.id.split('/').pop()}`} class="block p-4 rounded-lg border hover:border-[var(--color-accent)]" style="background: var(--color-card); border-color: var(--color-border);">
          <span class="text-[10px] uppercase tracking-wide text-[var(--color-muted)]">{cat.name}</span>
          <h3 class="font-semibold">{s.data.title}</h3>
          {s.data.description && <p class="text-sm text-[var(--color-muted)] mt-1">{s.data.description}</p>}
        </a>
      );
    })}
  </div>
</Base>
